pipeline {
    agent any

    tools {
        nodejs "node"
    }

    environment {
        IMAGE_NAME   = "urmidevops/node-app-1.0"
        IMAGE_TAG    = "${BUILD_NUMBER}"

        CLUSTER_NAME = "demo-eks-cluster"
        AWS_REGION   = "us-east-1"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Urmilaa/Deploy-NodeApp-to-AWS-EKS-using-Jenkins-Pipeline.git'
            }
        }

        stage('Install Node Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh '''
                    echo "======================================="
                    echo "IMAGE_NAME : ${IMAGE_NAME}"
                    echo "IMAGE_TAG  : ${IMAGE_TAG}"
                    echo "======================================="

                    docker images | grep node-app
                '''
            }
        }

        stage('Update Trivy Database') {
            steps {
                sh '''
                    trivy image \
                        --download-db-only \
                        --no-progress
                '''
            }
        }

        stage('Scan Docker Image') {
            steps {
                sh '''
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --no-progress \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Generate Trivy JSON Report') {
            steps {
                sh '''
                    trivy image \
                        --format json \
                        --output trivy-report.json \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_TOKEN" | docker login \
                        -u "$DOCKER_USER" \
                        --password-stdin
                    '''
                }
            }
        }

        stage('Push Docker Images') {
            steps {
                sh '''
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Deploy to Amazon EKS') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                        --name ${CLUSTER_NAME} \
                        --region ${AWS_REGION}

                    kubectl get nodes
                    kubectl get ns

                    kubectl apply -f nodejsapp.yaml

                    kubectl rollout status deployment/nodejs-app
                '''
            }
        }
    }

    post {

        always {

            archiveArtifacts artifacts: 'trivy-report.json',
                             fingerprint: true

            sh '''
                docker logout || true
            '''
        }

        success {

            echo "===================================="
            echo "Pipeline completed successfully."
            echo "Docker image scanned successfully."
            echo "Docker image pushed to Docker Hub."
            echo "Application deployed to EKS."
            echo "===================================="
        }

        failure {

            echo "===================================="
            echo "Pipeline failed."
            echo "Check Trivy scan or deployment logs."
            echo "===================================="
        }
    }
}
