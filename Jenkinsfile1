pipeline {
  agent any
  
   tools {nodejs "node"}
    
  stages {
    stage('Checkout') {
            steps {
                
                    git branch: 'main', url: 'https://github.com/Urmilaa/Deploy-NodeApp-to-AWS-EKS-using-Jenkins-Pipeline.git'
                
                 }
        }
     
    stage('Node JS Build') {
      steps {
        sh 'npm install'
      }
    }
  
     stage('Build Node JS Docker Image') {
            steps {
                script {
                  sh 'docker build -t urmidevops/node-app-1.0 .'
                }
            }
        }
       stage('Update Trivy Database') {
            steps {
                sh '''
                    echo "Updating Trivy vulnerability database..."

                    trivy image \
                        --download-db-only \
                        --no-progress
                '''
            }
        }

        stage('Scan Docker Image') {
            steps {
                sh '''
                    echo "Scanning Docker image..."

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --no-progress \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Generate Trivy JSON Report') {
            steps {
                sh '''
                    trivy image \
                        --format json \
                        --output trivy-report.json \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Deploy Docker Image to DockerHub') {
            steps {
                script {
              withCredentials([usernamePassword(
                              credentialsId: 'dockerhub-creds',
                              usernameVariable: 'DOCKER_USER',
                              passwordVariable: 'DOCKER_TOKEN'
              )]) {
                      sh '''
                      echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin
                      '''
                  }
            
                      sh 'docker push urmidevops/node-app-1.0'
               }
            }   
        }
         
     stage('Deploying Node App to Kubernetes') {
      steps {
        script {
          sh ('aws eks update-kubeconfig --name demo-eks-cluster --region us-east-1')
          sh "kubectl get ns"
          sh "kubectl apply -f nodejsapp.yaml"
        }
      }
    }
  }
   post {

        always {

            archiveArtifacts artifacts: '''
                trivy-report.json
            ''', fingerprint: true

            sh 'docker logout || true'
        }

        success {
            echo "Docker image scanned successfully."
            echo "Image pushed to Docker Hub."
        }

        failure {
            echo "Pipeline failed."
            echo "High/Critical vulnerabilities detected."
        }
    }



}
